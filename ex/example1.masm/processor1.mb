pos: 0, -1
type: Building
block: world-processor;
function main() {
    if(arc1.shooting) {
        u = bind(flare);
        u.move(arc1.shootX, arc1.shootY);
        message1.clear();
        message1.print("moving units");
    } else {
        u = bind(flare);
        u.move(this.x, this.y);
        message1.clear();
        message1.print("bringing back units")
    }
}